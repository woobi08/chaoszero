{
  "name": "chaoszero",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run tw:watch\" \"vite\"",
    "build": "npm run tw:build && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tw:build": "tailwindcss -i ./tailwind-static.css -o ./public/tailwind.css --minify",
    "tw:watch": "tailwindcss -i ./tailwind-static.css -o ./public/tailwind.css --watch"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
